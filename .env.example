# Clerk Authentication
# Get your keys at https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# CouchDB
COUCHDB_USER=admin
COUCHDB_PASSWORD=changeme
NEXT_PUBLIC_COUCHDB_URL=http://couchdb:5984

# App Port (optional, defaults to 80)
APP_PORT=8900

# Stock Portfolio Module
# Get your RapidAPI key at https://rapidapi.com/suneetk92/api/latest-stock-price
# Required for production (development uses mock data)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=latest-stock-price.p.rapidapi.com

# Optional: Default stock symbols to track (comma-separated)
# If not set, uses a predefined list of major Indian stocks
ACTIVE_SYMBOLS=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK,HINDUNILVR,ITC,SBIN,BHARTIARTL,KOTAKBANK