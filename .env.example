# Clerk Authentication
# Get your keys at https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# CouchDB
COUCHDB_USER=admin
COUCHDB_PASSWORD=changeme
NEXT_PUBLIC_COUCHDB_URL=http://couchdb:5984

# App Port (optional, defaults to 80)
APP_PORT=8900

# Stock Portfolio Module
# URL of the self-hosted yfinance stock-api running on your home server.
# Set this as an environment variable in Netlify (site settings → env vars).
# Example: https://stocks.yourdomain.com  or  http://your-home-ip:8000
STOCK_API_URL=http://your-home-server:8000

# Set to true to use generated mock prices (no stock-api required)
USE_MOCK_DATA=true

# Cache TTL for the stock-api service in seconds (default: 5 minutes)
# Configured in stock-api/docker-compose.yml on the home server
CACHE_TTL_SECONDS=300

# Optional: Default stock symbols to track (comma-separated, append :BSE for BSE exchange)
# If not set, uses a predefined list of major Indian stocks
ACTIVE_SYMBOLS=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK,HINDUNILVR,ITC,SBIN,BHARTIARTL,KOTAKBANK