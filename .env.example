# Clerk Authentication
# Get your keys at https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# CouchDB
COUCHDB_USER=admin
COUCHDB_PASSWORD=changeme
NEXT_PUBLIC_COUCHDB_URL=http://couchdb:5984

# App Port (optional, defaults to 80)
APP_PORT=8900

# NSE India live price cache
# Refresh fires automatically only when market is open (Mon–Fri 09:15–15:30 IST)
# and the cached data is older than this TTL. No NSE calls outside market hours.
# Default: 3600000 (1 hour) — max ~6 refreshes on a full trading day
NSE_CACHE_TTL_MS=3600000